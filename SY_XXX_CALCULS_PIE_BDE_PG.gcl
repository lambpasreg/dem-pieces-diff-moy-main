//Temperature min, max et differentiel moyen
'SY_xxx T_PIE_MIN' = Min ((Read ("BDE:BDE1 10101.tp")), (Read ("BDE:BDE1 10102.tp")),
                          (Read ("BDE:BDE1 10103.tp")), (Read ("BDE:BDE1 10104.tp")),
                          (Read ("BDE:BDE1 10105.tp")), (Read ("BDE:BDE1 10106.tp")),
                          (Read ("BDE:BDE1 10107.tp")), (Read ("BDE:BDE1 10108.tp")),
                          (Read ("BDE:BDE1 10109.tp")), (Read ("BDE:BDE1 10110.tp")),
                          (Read ("BDE:BDE1 10111.tp")), (Read ("BDE:BDE1 10112.tp")),
                          (Read ("BDE:BDE1 10113.tp")), (Read ("BDE:BDE1 10114.tp")),
                          (Read ("BDE:BDE1 10115.tp")), (Read ("BDE:BDE1 10116.tp")),
                          (Read ("BDE:BDE1 10117.tp")), (Read ("BDE:BDE1 10118.tp")),
                          (Read ("BDE:BDE1 10119.tp")), (Read ("BDE:BDE1 10120.tp")),
                          (Read ("BDE:BDE1 10121.tp")), (Read ("BDE:BDE1 10122.tp")),
                          (Read ("BDE:BDE1 10123.tp")), (Read ("BDE:BDE1 10124.tp")),
                          (Read ("BDE:BDE1 10125.tp")), (Read ("BDE:BDE1 10126.tp")),
                          (Read ("BDE:BDE1 10127.tp")), (Read ("BDE:BDE1 10128.tp")),
                          (Read ("BDE:BDE1 10129.tp")))
                

'SY_xxx T_PIE_MAX' = Max ((Read ("BDE:BDE1 10101.tp")), (Read ("BDE:BDE1 10102.tp")),
                          (Read ("BDE:BDE1 10103.tp")), (Read ("BDE:BDE1 10104.tp")),
                          (Read ("BDE:BDE1 10105.tp")), (Read ("BDE:BDE1 10106.tp")),
                          (Read ("BDE:BDE1 10107.tp")), (Read ("BDE:BDE1 10108.tp")),
                          (Read ("BDE:BDE1 10109.tp")), (Read ("BDE:BDE1 10110.tp")),
                          (Read ("BDE:BDE1 10111.tp")), (Read ("BDE:BDE1 10112.tp")),
                          (Read ("BDE:BDE1 10113.tp")), (Read ("BDE:BDE1 10114.tp")),
                          (Read ("BDE:BDE1 10115.tp")), (Read ("BDE:BDE1 10116.tp")),
                          (Read ("BDE:BDE1 10117.tp")), (Read ("BDE:BDE1 10118.tp")),
                          (Read ("BDE:BDE1 10119.tp")), (Read ("BDE:BDE1 10120.tp")),
                          (Read ("BDE:BDE1 10121.tp")), (Read ("BDE:BDE1 10122.tp")),
                          (Read ("BDE:BDE1 10123.tp")), (Read ("BDE:BDE1 10124.tp")),
                          (Read ("BDE:BDE1 10125.tp")), (Read ("BDE:BDE1 10126.tp")),
                          (Read ("BDE:BDE1 10127.tp")), (Read ("BDE:BDE1 10128.tp")),
                          (Read ("BDE:BDE1 10129.tp")))


'SY_xxx DIFF_PIE_MOY' = Average ((Read ("BDE:BDE1 10101.diff_tp")), (Read ("BDE:BDE1 10102.diff_tp")),
                                 (Read ("BDE:BDE1 10103.diff_tp")), (Read ("BDE:BDE1 10104.diff_tp")),
                                 (Read ("BDE:BDE1 10105.diff_tp")), (Read ("BDE:BDE1 10106.diff_tp")),
                                 (Read ("BDE:BDE1 10107.diff_tp")), (Read ("BDE:BDE1 10108.diff_tp")),
                                 (Read ("BDE:BDE1 10109.diff_tp")), (Read ("BDE:BDE1 10110.diff_tp")),
                                 (Read ("BDE:BDE1 10111.diff_tp")), (Read ("BDE:BDE1 10112.diff_tp")),
                                 (Read ("BDE:BDE1 10113.diff_tp")), (Read ("BDE:BDE1 10114.diff_tp")),
